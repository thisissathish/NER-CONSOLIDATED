# Database Configuration
DATABASE_URL=postgresql://ner_user:ner_pass@localhost:5432/ner_logistics

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# OpenWeatherMap API
OPENWEATHERMAP_API_KEY=your_api_key_here

# Application Settings
APP_NAME="NER Smart Logistics Platform"
APP_VERSION=1.0.0
DEBUG=True

# Pilot Corridor Bounds (Guwahati-Shillong)
CORRIDOR_MIN_LAT=25.5
CORRIDOR_MAX_LAT=26.2
CORRIDOR_MIN_LON=91.5
CORRIDOR_MAX_LON=92.0
